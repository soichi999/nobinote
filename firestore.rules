rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 匿名サインインしたクライアントのみ許可。
    // 4桁パスコードはアプリ側での照合であり、ルールでは検証できません
    // （＝URLとパスコードは身内だけで共有してください）。
    function ok() { return request.auth != null; }

    match /config/{id}      { allow read, write: if ok(); }
    match /students/{sid} {
      allow read, write: if ok();
      match /{sub=**}       { allow read, write: if ok(); }
    }

    // チューター向け「今日やること」ダッシュボードが全生徒を横断して見るための
    // collectionGroup クエリ用ルール（上の /students/{sid}/{sub=**} は個別パス読み込みにしか効かない）
    match /{path=**}/homework/{id} { allow read: if ok(); }
    match /{path=**}/schedule/{id} { allow read: if ok(); }
    match /{path=**}/tuition/{id}  { allow read: if ok(); }
  }
}
